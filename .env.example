# UrbanEnergy Insight Environment Configuration
# Copy this file to .env and adjust variables as needed

PORT=3000
NODE_ENV=development

# Optional PostgreSQL Connection String
# Example: postgresql://postgres:password@localhost:5432/urbanenergy
# When not provided, UrbanEnergy Insight operates seamlessly with its persistent local store
DATABASE_URL=

# Session / Authentication secret
JWT_SECRET=urbanenergy-development-session-key-change-in-prod-2026

# Default consumption units (kWh or MWh)
DEFAULT_ENERGY_UNIT=kWh

# High Consumption Threshold Multiplier (e.g., 1.25 means 25% above baseline median)
HIGH_CONSUMPTION_THRESHOLD_MULTIPLIER=1.25
